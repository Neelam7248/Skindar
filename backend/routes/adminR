const express = require("express");
const router = express.Router();
const User = require("../models/User"); // Admin model ka path adjust karein

// @route   GET /api/admin/contact
// @desc    Get admin contact info
// @access  Public (ya auth required agar chahen)
router.get("/contact", async (req, res) => {
  try {
    const admin = await User.findOne({userType:"admin"}); // pehla admin document
    if (!admin) {
      return res.status(404).json({ error: "Admin not found" });
    }

    res.json({
      name: admin.name,
      phone: admin.phone,
      email: admin.email || "", // agar email bhi chahen
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Failed to fetch admin contact" });
  }
});

module.exports = router;
